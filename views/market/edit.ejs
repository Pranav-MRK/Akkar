<% layout("layouts/boilarplate") -%>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm border-0 p-4" style="border-radius: 15px;">
            <h3 class="fw-bold mb-4 text-center">Edit Item</h3>
            <form action="/marketplace/<%= market._id %>?_method=PUT" method="POST">
                <div class="mb-3">
                    <label for="name" class="form-label fw-bold">Name</label>
                    <input type="text" name="market[name]" id="name" class="form-control" value="<%= market.name %>" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label fw-bold">Description</label>
                    <textarea name="market[description]" id="description" class="form-control" required><%= market.description %></textarea>
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label fw-bold">Price</label>
                    <input type="number" name="market[price]" id="price" class="form-control" value="<%= market.price %>" required>
                </div>
                <div class="mb-3">
                    <label for="url" class="form-label fw-bold">Image URL</label>
                    <input type="text" name="market[image][url]" id="url" class="form-control" value="<%= market.image.url %>" required>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold">Save Changes</button>
                    <a href="/marketplace" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                </div>
            </form>
        </div>    
    </div>            
</div>